# Copy to .env.local (git-ignored) and fill in from
# Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where invite emails send people. Only needed when sending invites from
# a dev server, or to override the live origin. Whatever you set must
# also be listed under Supabase → Authentication → URL Configuration →
# Redirect URLs, or Supabase silently uses the project's Site URL
# instead — which is how invites end up pointing at localhost.
# VITE_SITE_URL=https://olc-companytrip.vercel.app
